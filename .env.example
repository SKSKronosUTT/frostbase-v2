# --- Base de datos PostgreSQL ---
POSTGRES_DB=frostbase
POSTGRES_USER=frostbase
POSTGRES_PASSWORD=cambia-esta-contrasena-de-base-de-datos
DATABASE_URL=postgresql+psycopg://frostbase:cambia-esta-contrasena-de-base-de-datos@localhost:5432/frostbase

# --- Seguridad ---
# Genere una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-secreta-por-una-aleatoria-de-al-menos-64-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Administrador inicial (solo se crea si no existe ningún administrador) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@frostbase.local
ADMIN_PASSWORD=cambia-esta-contrasena-de-administrador

# --- Aplicación ---
ENVIRONMENT=development
APP_PORT=8050
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:8050,http://127.0.0.1:8050,http://localhost:8060,http://127.0.0.1:8060,http://localhost:8070,http://127.0.0.1:8070

# --- Monitoreo ---
DEVICE_OFFLINE_SECONDS=60
DASHBOARD_FRESH_MINUTES=10
DISCONNECT_CHECK_SECONDS=30

# --- Servicios externos ---
OSRM_BASE_URL=https://router.project-osrm.org
WEATHER_CITY=Tijuana
WEATHER_LATITUDE=32.5149
WEATHER_LONGITUDE=-117.0382
WEATHER_CACHE_SECONDS=600

# --- Frontend (ruta alternativa opcional) ---
# FRONTEND_DIR=/ruta/absoluta/al/frontend
