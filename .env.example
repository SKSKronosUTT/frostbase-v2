# Copie este archivo a `.env` y complete los valores obligatorios.
# El arranque falla de forma deliberada si SECRET_KEY, DEVICE_KEY_PEPPER,
# ADMIN_PASSWORD o POSTGRES_PASSWORD quedan vacíos.

# --- Base de datos PostgreSQL ---
POSTGRES_DB=frostbase
POSTGRES_USER=frostbase
POSTGRES_PASSWORD=
# Solo para ejecución local fuera de Docker. Compose construye su propia URL.
DATABASE_URL=postgresql+psycopg://frostbase:REEMPLAZAR@localhost:5432/frostbase

# --- Seguridad (obligatorios) ---
# Genere cada secreto con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Mínimo 64 caracteres. No use prefijos "dev-only" ni "cambia-".
SECRET_KEY=
DEVICE_KEY_PEPPER=
# true: cachea el acierto Argon2 de dispositivos legacy (TTL 300 s).
# false: vuelve a Argon2 puro por lectura en dispositivos legacy.
DEVICE_KEY_FAST_PATH=true
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Administrador inicial (solo se crea si no existe ningún administrador) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@frostbase.local
# Obligatoria, mínimo 12 caracteres. Se fuerza su cambio en el primer login.
ADMIN_PASSWORD=

# --- Aplicación ---
# development para uso local; en un despliegue real use production
# (obliga COOKIE_SECURE=true y prohíbe datos demo).
ENVIRONMENT=development
APP_PORT=8050
# Solo desarrollo/tests. En producción debe ser false (Alembic gobierna el esquema).
AUTO_CREATE_TABLES=false
# Datos de demostración al inicializar (camiones, conductores, rutas, viajes,
# lecturas y alertas). Idempotente: no duplica al reiniciar. Déjelo en false en
# producción (el arranque falla con SEED_DEMO_DATA=true y ENVIRONMENT=production).
SEED_DEMO_DATA=true
RATE_LIMIT_BACKEND=memory
REDIS_URL=
CORS_ORIGINS=http://localhost:8050,http://127.0.0.1:8050,http://localhost:8060,http://127.0.0.1:8060,http://localhost:8070,http://127.0.0.1:8070
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Monitoreo ---
DASHBOARD_FRESH_MINUTES=10
DISCONNECT_CHECK_SECONDS=30
# true solo en desarrollo sin el servicio `watcher` de compose.
ENABLE_INPROCESS_WATCHER=false
WEB_CONCURRENCY=2
# Zona horaria de negocio para el calendario semanal de rutas.
APP_TIMEZONE=America/Tijuana

# --- Retención de datos ---
READINGS_RETENTION_DAYS=90
RESOLVED_ALERTS_RETENTION_DAYS=365
RETENTION_CHECK_SECONDS=86400

# --- Límites de peticiones (ventana deslizante) ---
IOT_DEVICE_RATE_LIMIT=30
IOT_IP_RATE_LIMIT=120
LOGIN_IP_RATE_LIMIT=5
LOGIN_IDENTIFIER_RATE_LIMIT=10

# --- Servicios externos ---
# Asistente IA (ESP-Claw en el ESP32-S3). Deshabilitado por defecto.
# AI_AGENT_URL: IP de la LAN del ESP32 (recomendado) o el AP http://192.168.4.1.
AI_AGENT_ENABLED=false
AI_AGENT_URL=
AI_AGENT_TOKEN=
AI_AGENT_TIMEOUT_SECONDS=90
AI_AGENT_CONNECT_TIMEOUT_SECONDS=5
AI_AGENT_POLL_INTERVAL_SECONDS=1
AI_AGENT_MAX_MESSAGE_CHARS=500
AI_AGENT_RATE_LIMIT=6
AI_AGENT_DAILY_LIMIT=100
AI_AGENT_STATUS_CACHE_SECONDS=15
# Token de solo lectura que usará el agente para /api/v1/agent-read/* (A2).
AI_AGENT_READ_TOKEN=

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=5
WEATHER_TIMEOUT_SECONDS=3
WEATHER_CACHE_SECONDS=600
# false: OSRM síncrono (no bloqueante para el event loop) al guardar la ruta.
# true: guarda la ruta al instante y calcula la geometría en segundo plano.
ROUTE_GEOMETRY_ASYNC=false

# --- Frontend (ruta alternativa opcional) ---
# FRONTEND_DIR=/ruta/absoluta/al/frontend
