# URL base de la API de FrostBase (incluye /api/v1)
FROSTBASE_API_URL=http://localhost:8050/api/v1

# Identificador del dispositivo registrado en FrostBase
DEVICE_ID=ESP32-DEMO-001

# Clave del dispositivo: cadena larga (~43 caracteres) que imprime el seed al
# crear el dispositivo o al rotar su clave. NO es la placa del camión
# (ABC-123-A). Si no la tiene, rote la clave desde el panel o con
# `docker compose exec app python -m scripts.rotate_device_key --device-id ...`
DEVICE_KEY=

# Intervalo entre lecturas, en segundos
INTERVAL_SECONDS=10

# Probabilidad de generar una anomalía por lectura (0.01 = 1%)
ANOMALY_PROBABILITY=0.01

# G7: probabilidad de abrir la puerta por ciclo (0 = deshabilitado). Si se
# abre, el simulador envía is_open=true y la cierra tras DOOR_OPEN_CYCLES.
DOOR_OPEN_PROBABILITY=0.0

# Ciclos que la puerta permanece abierta antes de cerrarse (1 ciclo = INTERVAL_SECONDS)
DOOR_OPEN_CYCLES=3

# Velocidad simulada sobre la ruta, en km/h
SPEED_KMH=30

# Posición fija si el camión no tiene ruta (Tijuana por defecto)
FIXED_LATITUDE=32.5149
FIXED_LONGITUDE=-117.0382

# Cada cuántas lecturas se refresca la configuración (rangos y ruta)
CONFIG_REFRESH_CYCLES=30

# Timeout de las peticiones HTTP, en segundos
REQUEST_TIMEOUT=8
