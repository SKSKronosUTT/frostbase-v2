# URL base de la API de FrostBase (incluye /api/v1)
FROSTBASE_API_URL=http://localhost:8000/api/v1

# Identificador del dispositivo registrado en FrostBase
DEVICE_ID=ESP32-FROST-001

# Clave del dispositivo (se muestra una sola vez al crear el dispositivo o con el seed)
DEVICE_KEY=

# Intervalo entre lecturas, en segundos
INTERVAL_SECONDS=10

# Probabilidad de generar una anomalía por lectura (0.01 = 1%)
ANOMALY_PROBABILITY=0.01

# Velocidad simulada sobre la ruta, en km/h
SPEED_KMH=30

# Posición fija si el camión no tiene ruta (Tijuana por defecto)
FIXED_LATITUDE=32.5149
FIXED_LONGITUDE=-117.0382

# Cada cuántas lecturas se refresca la configuración (rangos y ruta)
CONFIG_REFRESH_CYCLES=30

# Timeout de las peticiones HTTP, en segundos
REQUEST_TIMEOUT=8
