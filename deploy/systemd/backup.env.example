# /etc/frostbase/backup.env
# Permisos recomendados: root:frostbase, modo 600.
#   sudo install -o root -g frostbase -m 600 \
#       deploy/systemd/backup.env.example /etc/frostbase/backup.env

# Raíz del repositorio desplegado
FROSTBASE_DIR=/opt/frostbase
FROSTBASE_PYTHON=/usr/bin/python3
FROSTBASE_DB=frostbase

# Carpeta local de respaldos (fuera del repositorio)
FROSTBASE_BACKUP_DIR=/var/backups/frostbase

# Copia externa verificada (NAS, disco montado, bucket sincronizado).
# Deje vacío para deshabilitar el espejo.
FROSTBASE_MIRROR_DIR=/mnt/offsite/frostbase

# Archivo con la passphrase (mínimo 12 caracteres, recomendado 32+).
FROSTBASE_BACKUP_PASSPHRASE_FILE=/etc/frostbase/backup.pass

# Retención: se conservan siempre los últimos KEEP_LAST y además los que
# tengan menos de RETENTION_DAYS días.
FROSTBASE_RETENTION_DAYS=30
FROSTBASE_KEEP_LAST=7
